{
  "name": "solar-dimension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p scripts",
    "test": "vitest run",
    "start": "node --env-file-if-exists=.env.local .output/server/index.mjs",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.9",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.48.0",
    "nitro": "^3.0.260903-beta",
    "openai": "^6.49.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
