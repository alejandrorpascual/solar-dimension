    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
