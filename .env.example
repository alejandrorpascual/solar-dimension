DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated; the account must have a verified email (sign in with Google once).
ADMIN_EMAILS=
# At least 32 random characters: openssl rand -hex 32. Unset = catalog API disabled.
CATALOG_API_TOKEN=
# Base URL the /research-appliance and /research-product skills use with --target prod.
CATALOG_API_URL=
# TEST_DB_ENDPOINT does not belong in an env file: the e2e guard (e2e/test-env.ts) sets it for the servers it starts,
# after checking their database, and a server on that endpoint answers GET /api/catalog/database with "test".
# Quotes (see README → Quotes)
OPENAI_API_KEY=
QUOTES_MODEL_PRIMARY=gpt-6-luna
QUOTES_MODEL_FALLBACK=gpt-6-sol
BLOB_READ_WRITE_TOKEN=
# At least 32 random characters: openssl rand -hex 32. Shorter, the daily sweep refuses every call and logs an error.
CRON_SECRET=
# Model reads admitted per UTC day across every account (uploads and retries). Default 100; set 0 to pause. Each read can cost up
# to 12 model calls (3 attempts, each a primary and a fallback call, either repeated once on a transient error).
QUOTES_DAILY_READS=100
# Previews and tests only: comma-separated emails that may upload without a verified (Google) email. Ignored when VERCEL_ENV=production.
QUOTES_TRUSTED_EMAILS=
# Development and E2E only: local files and a fixture model instead of Blob and OpenAI
# QUOTES_STORAGE=local
# QUOTES_MODEL_STUB=1
# QUOTES_STUB_DELAY_MS=1500
# How often the page asks about quotes being read, in ms (default 3000): lower it only beside a fast stub, as e2e does
# QUOTES_POLL_MS=3000
