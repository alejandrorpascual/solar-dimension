DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated; the account must have a verified email (sign in with Google once).
ADMIN_EMAILS=
# At least 32 random characters: openssl rand -hex 32. Unset = catalog API disabled.
CATALOG_API_TOKEN=
# Base URL the /research-appliance skill uses with --target prod.
CATALOG_API_URL=
# Quotes (see README → Quotes)
OPENAI_API_KEY=
QUOTES_MODEL_PRIMARY=gpt-6-luna
QUOTES_MODEL_FALLBACK=gpt-6-sol
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
# Model reads admitted per UTC day across every account (uploads and retries). Default 100. Each read can cost up
# to 12 model calls (3 attempts, each a primary and a fallback call, either repeated once on a transient error).
QUOTES_DAILY_READS=100
# Previews and tests only: comma-separated emails that may upload without a verified (Google) email. Leave unset in production.
QUOTES_TRUSTED_EMAILS=
# Development and E2E only: local files and a fixture model instead of Blob and OpenAI
# QUOTES_STORAGE=local
# QUOTES_MODEL_STUB=1
# QUOTES_STUB_DELAY_MS=1500
