# AC2 witness on ddf681e: the hook test below, appended after otherTabEdits in useProjectStore.sync.test.ts's setup, run with
# npx vitest run src/hooks/qa-ac2-witness.test.ts   (file not committed; expected red until the AC2 race is fixed)


test('an edit made before the re-read answers keeps the hours another device saved', async () => {
  session.user = ANA
  await mount()
  accounts.set(ANA.id, account(ANA).map((p) => ({ ...p, hours: 20, updatedAt: clock.now() })))
  let answer!: () => void
  net.gate = new Promise<void>((resolve) => { answer = resolve })

  await comeBack()
  await edit((h) => h.commit(patchCurrent(h.store, { volts: 48 })))
  net.gate = null
  answer()
  const after = await edit(() => undefined)

  expect({ screen: home(after.store.projects), account: home(account(ANA)) }).toMatchObject({
    screen: { hours: 20, volts: 48 },
    account: { hours: 20, volts: 48 },
  })
})

