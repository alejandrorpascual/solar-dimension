{
  "version": 1,
  "description": "solar-dimension build pipeline",
  "project": {
    "owner": "alejandrorpascual",
    "title": "Solar Dimension",
    "number": 1
  },
  "worker_backend": "workflow",
  "model_tier": "medium",
  "codex": {
    "model": null
  },
  "target": {
    "type": "repo",
    "url": null
  },
  "repo": {
    "path": ".",
    "remote": "https://github.com/alejandrorpascual/solar-dimension"
  },
  "base_branch": "staging",
  "timezone": "America/Caracas",
  "columns": [
    "Backlog",
    "Ready",
    "Building",
    "QA",
    "Review",
    "Blocked",
    "Done"
  ],
  "labels": [
    "qa",
    "bug",
    "feature"
  ],
  "paths": {
    "project_md": "docs/super-board/PROJECT.md",
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },
  "human_approves_merge": false,
  "merge_policy": {
    "default": "auto",
    "auto_max_lines": 400,
    "always_human": {
      "money": {
        "labels": [
          "money",
          "payments",
          "billing",
          "pricing"
        ],
        "paths": [
          "**/billing/**",
          "**/payments/**",
          "**/stripe/**",
          "**/checkout/**"
        ],
        "keywords": [
          "stripe.",
          "payment_intent",
          "price_id",
          "invoice.create"
        ]
      },
      "auth": {
        "labels": [
          "auth",
          "security"
        ],
        "paths": [
          "**/auth/**",
          "**/authz/**",
          "**/permissions/**",
          "src/lib/auth*",
          "src/db/auth-schema.ts",
          "src/lib/admin.ts",
          "src/server/session.ts"
        ],
        "keywords": [
          "jwt.sign",
          "bcrypt",
          "password_hash",
          "service_role",
          "betterAuth(",
          "BETTER_AUTH_SECRET",
          "ADMIN_EMAILS"
        ]
      },
      "schema": {
        "labels": [
          "schema",
          "destructive"
        ],
        "paths": [],
        "keywords": [
          "drop table",
          "drop column",
          "truncate table",
          "rename column",
          "drop schema"
        ]
      }
    },
    "allow_auto_on_production": false
  },
  "migrations": {
    "globs": [
      "drizzle/**"
    ],
    "allowed_envs": [
      "test",
      "staging"
    ],
    "target_env": "staging",
    "commands": {
      "test": "node --env-file=/Users/alejandrorpascual/projects/solar-dimension/.env.test.local scripts/migrate.ts",
      "staging": "-"
    },
    "checks": {
      "test": "node --env-file=/Users/alejandrorpascual/projects/solar-dimension/.env.test.local scripts/migrate.ts --check"
    },
    "human_steps": []
  },
  "no_progress_cycles": 6,
  "max_dispatches": 0,
  "truth_gate": "non-trivial",
  "truth_threshold": 70,
  "usage_pause_pct": 95,
  "usage_fallback": "none",
  "verify_commands": [
    "npm ci --silent && npm run typecheck && npm run test:coverage && npm run build"
  ],
  "collect": {
    "sources": [
      "github",
      "prs",
      "phase-a-audit"
    ],
    "window_days": 14,
    "prs": {
      "max_prs": 200
    },
    "custom": [
      {
        "name": "phase-a-audit",
        "kind": "cli",
        "target": "python3 .claude/super-board/sources/phase-a-audit.py /Users/alejandrorpascual/projects/solar-dimension/docs/audits/evidence/findings.json alejandrorpascual/solar-dimension",
        "map": {
          "id": "id",
          "title": "title",
          "body": "body"
        }
      }
    ]
  },
  "notifications": {
    "channel": "session",
    "chat_id": null,
    "bot_identity": "alejandrorpascual-bot"
  }
}
