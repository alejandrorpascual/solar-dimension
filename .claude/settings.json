{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "neon skills update -y 2>/dev/null || true",
            "async": true,
            "timeout": 120,
            "suppressOutput": true,
            "statusMessage": "Updating Neon skills…"
          }
        ]
      }
    ]
  }
}
